# Copia este archivo como .env y ajusta los valores

# Base de datos: Supabase PostgreSQL (obligatoria). Copia la cadena de conexión desde el panel Connect.
# Para App Service, prefiere Session Pooler (host *.pooler.supabase.com, puerto 5432).
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:CLAVE@HOST.pooler.supabase.com:5432/postgres?sslmode=require
# Si la clave tiene caracteres especiales (@ : / # ?), codifícalos en la URL: @ -> %40, # -> %23

# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion-por-una-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Orígenes del frontend web (formato JSON)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
