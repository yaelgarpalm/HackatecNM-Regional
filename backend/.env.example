# Copia este archivo como .env y ajusta los valores

# Desarrollo (sin instalar nada):
DATABASE_URL=sqlite:///./vinculatec.db
# Producción / PostgreSQL:
# DATABASE_URL=postgresql+psycopg://vinculatec:vinculatec@localhost:5432/vinculatec

# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion-por-una-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Orígenes del frontend web (formato JSON)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
